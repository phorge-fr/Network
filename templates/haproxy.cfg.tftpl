global
    user haproxy
    group haproxy
    chroot /var/lib/haproxy
    log stdout format raw local0 info
    stats timeout 30s
    ssl-default-bind-options ssl-min-ver TLSv1.2
    tune.ssl.default-dh-param 2048
    maxconn 100000

defaults
    mode tcp
    timeout connect 5s
    timeout client 30s
    timeout client-fin 30s
    timeout server 120s
    timeout tunnel 6h
    timeout http-request 5s
    maxconn 80000

backend http-301
    mode http
    redirect scheme https code 301

backend http-control-ingress
    mode http
    server ingress-server ${ingress["ctrl"]}:80

backend https-control-ingress
    mode tcp
    server ingress-server ${ingress["ctrl"]}:443 send-proxy-v2

backend http-core-ingress
    mode http
    server ingress-server ${ingress["core"]}:80

backend https-core-ingress
    mode tcp
    server ingress-server ${ingress["core"]}:443 send-proxy-v2

backend http-svc-ingress
    mode http
    server ingress-server ${ingress["svc"]}:80

backend https-svc-ingress
    mode tcp
    server ingress-server ${ingress["svc"]}:443 send-proxy-v2

backend incus-cluster
    mode tcp
    balance source
    option tcp-check
%{ for ip in incus_nodes ~}
    server comp-opti-${format("%02d", tonumber(split(".", ip)[3]))} ${ip}:8443 check
%{ endfor ~}

frontend http-dispatcher
    bind :8080
    mode http

    acl host_iaas hdr(host) -i iaas.phorge.fr
    http-request redirect scheme https code 301 if host_iaas

    acl host_auth hdr(host) -i auth.phorge.fr
    http-request redirect scheme https code 301 if host_auth

    acl host_monitoring hdr(host) -i monitoring.phorge.fr
    http-request redirect scheme https code 301 if host_monitoring

    acl host_status hdr(host) -i status.phorge.fr
    http-request redirect scheme https code 301 if host_status

    acl host_git hdr(host) -i git.phorge.fr
    http-request redirect scheme https code 301 if host_git

    default_backend http-control-ingress

frontend sni-dispatcher
    bind :8443
    mode tcp

    tcp-request inspect-delay 5s
    tcp-request content accept if { req.ssl_hello_type 1 }

    use_backend incus-cluster if { req.ssl_sni -i iaas.phorge.fr }

    use_backend https-core-ingress if { req.ssl_sni -i auth.phorge.fr }

    use_backend https-core-ingress if { req.ssl_sni -i monitoring.phorge.fr }

    use_backend https-core-ingress if { req.ssl_sni -i status.phorge.fr }

    use_backend https-svc-ingress if { req.ssl_sni -i git.phorge.fr }

    default_backend https-control-ingress
